# Copy to .env (never commit it). Everything is optional; with nothing set the app runs rules-only and simulates alerts.
CRM_DB=var/crm.sqlite
# send demo/webhook traffic through a running n8n instead of the built-in engine
N8N_WEBHOOK_URL=
# n8n side: where the workflow reaches this app
CRM_BASE_URL=http://127.0.0.1:8830
# optional LLM scorer (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# notifications: Slack wins if both are set
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional Google Sheets mirror (Apps Script web app URL that appends the posted row)
SHEETS_WEBHOOK_URL=
